# Terraform working state — never in git.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Per-deployment configuration; the .example files are the committed contract.
backend.hcl
*.tfvars
!*.tfvars.example

# Install tooling: per-deployment identity and secrets, rendered artifacts.
install.conf
.env
aws/kots/generated/
aws/build/
