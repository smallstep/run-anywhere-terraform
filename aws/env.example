# Copy to .env (gitignored). scripts/lib.sh sources it when present.
#
#   cp env.example .env

# Dashboard API token: https://app.<base_domain> -> Settings -> API Tokens.
# Used by `make verify STAGE=app` for the gateway API check; that check is
# skipped when this is empty. There is no headless way to mint it.
SMALLSTEP_API_TOKEN=
