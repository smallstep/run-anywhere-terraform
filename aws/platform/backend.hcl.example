# Copy to backend.hcl and set the bucket. The bucket is created once, by hand,
# before the first init (see the README); versioning and S3-native locking
# (use_lockfile) mean no DynamoDB table.
bucket       = "smallstep-tfstate-000000000000"
key          = "platform.tfstate"
region       = "us-east-2"
use_lockfile = true
